{
  "name": "planning-console-backend",
  "version": "1.0.0",
  "description": "Backend API for Planning Console AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrations/run.ts",
    "seed": "tsx src/db/seed/run.ts",
    "migrate:pc": "tsx src/db/migrations/create_pc_db.ts",
    "seed:pc": "tsx src/db/seed/seed_pc_db.ts",
    "refresh:duckdb": "tsx src/db/refresh_duckdb.ts",
    "refresh:duckdb:simple": "tsx src/db/refresh_duckdb_simple.ts",
    "install:skip-duckdb": "npm install --ignore-scripts duckdb || npm install"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "duckdb": "^1.4.2",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "neo4j-driver": "^5.15.0",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
